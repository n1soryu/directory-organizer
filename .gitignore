.build/
build/
*.app
.swiftpm/

# --- OS / editors ---
.DS_Store
.vscode/
.idea/

# --- Local agent tooling ---
.atlas/

# --- Coverage data from running debug builds ---
*.profraw

# --- organize eval results (local, per machine) ---
eval-results/
